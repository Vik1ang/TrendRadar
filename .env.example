# Copy to .env and set fresh random secrets. Do not commit .env.
POSTGRES_DB=intelligence
POSTGRES_USER=intelligence
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Single-user static bearer currently validated by Fastify and by the Worker.
# Configure the Cloudflare CLIENT_API_TOKEN secret to the SAME value. Rotation
# revokes the previous token; individual expiry/device revocation is not yet implemented.
API_READ_TOKEN=replace-with-a-long-random-read-token
INGEST_TOKEN=replace-with-a-separate-long-random-ingest-token

# Turn on only after the private intelligence stack is healthy and the existing
# TrendRadar compose project uses docker/trendradar-intelligence.override.yml.
INTELLIGENCE_ENABLED=false
INTELLIGENCE_ANALYSIS_ENABLED=false
INTELLIGENCE_MAX_ANALYSES_PER_RUN=1
INTELLIGENCE_MAX_ANALYSES_PER_DAY=0
INTELLIGENCE_ANALYSIS_MAX_CONCURRENT=1
INTELLIGENCE_ANALYSIS_MAX_ATTEMPTS=2
INTELLIGENCE_INGEST_URL=http://ingest-api:3002/api/v1/internal/ingestion
INTELLIGENCE_SYNC_INTERVAL_SECONDS=60
TREND_RADAR_TIMEZONE=Asia/Shanghai

# Safe default: both API and Web bind to loopback. Set WEB_BIND_ADDRESS to this
# server's LAN IP only when LAN access is needed; restrict it with the host firewall.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8081

# P4 Relay machine credential is independent from the client/backend bearer.
# Configure Cloudflare RELAY_AGENT_TOKEN to the SAME value; never use API_READ_TOKEN here.
RELAY_WORKER_URL=https://your-worker.workers.dev
RELAY_AGENT_TOKEN=replace-with-a-separate-random-agent-token
# Optional: proxy must be reachable from the Agent container, e.g. configured host gateway.
RELAY_PROXY_URL=
