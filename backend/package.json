{
  "name": "trendradar-intelligence-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/db/migrate.js",
    "device:auth": "node dist/src/device-auth-cli.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^5.2.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "typebox": "^1.0.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
